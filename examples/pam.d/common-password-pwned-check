# Example only. Do not copy into production without testing and rollback access.
#
# Debian/Ubuntu-style placement:
# Add this before pam_unix.so in /etc/pam.d/common-password so pwned passwords
# are rejected before the local password is changed.
#
# pam_exec.so expose_authtok sends the candidate password to the helper over
# stdin. The helper then invokes pwned-check --stdin with its own hard timeout.
password requisite pam_exec.so expose_authtok quiet /usr/local/bin/pwned-check-pam-helper --checker /usr/local/bin/pwned-check --timeout 3s
